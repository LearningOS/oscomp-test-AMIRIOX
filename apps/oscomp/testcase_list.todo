# test add
/musl/busybox echo "#### OS COMP TEST GROUP START busybox ####"
/musl/busybox echo "#### independent command test"
/musl/busybox ash -c exit
/musl/busybox sh -c exit
/musl/busybox basename /aaa/bbb
/musl/busybox cal
/musl/busybox clear
/musl/busybox date
/musl/busybox dirname /aaa/bbb
/musl/busybox expr 1 + 1
/musl/busybox false
/musl/busybox true
/musl/busybox which ls
/musl/busybox uname
/musl/busybox uptime
/musl/busybox printf "abcn"
/musl/busybox pwd
/musl/busybox echo "#### OS COMP TEST GROUP END busybox ####"


# libc
/musl/runtest.exe -w entry-dynamic.exe tls_get_new_dtv  # sys_futex needed
/musl/runtest.exe -w entry-dynamic.exe pthread_*
/musl/runtest.exe -w entry-static.exe setjmp
/musl/runtest.exe -w entry-static.exe socket
/musl/runtest.exe -w entry-dynamic.exe *stat
/musl/runtest.exe -w entry-static.exe statvfs
/musl/runtest.exe -w entry-static.exe utime
/musl/runtest.exe -w entry-dynamic.exe dlopen

# only x86_64
*scanf

# only loongarch64
putenv_doublefree
regex_bracket_icase
/musl/runtest.exe -w entry-dynamic.exe regex_ere_backref
/musl/runtest.exe -w entry-dynamic.exe regex_escaped_high_byte
/musl/runtest.exe -w entry-dynamic.exe regex_negated_range
/musl/runtest.exe -w entry-dynamic.exe regexec_nosub
/musl/runtest.exe -w entry-dynamic.exe printf_fmt_n
/musl/runtest.exe -w entry-dynamic.exe pthread_condattr_setclock
/musl/runtest.exe -w entry-dynamic.exe regex_backref_0
/musl/runtest.exe -w entry-dynamic.exe rewind_clear_error
/musl/runtest.exe -w entry-dynamic.exe rlimit_open_files

